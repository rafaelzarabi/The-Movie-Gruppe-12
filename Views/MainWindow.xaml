<Window x:Class="The_Movie_Gruppe_12.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Movie_Gruppe_12"
        mc:Ignorable="d"
        Title="The Movies Film Register" Height="450" Width="600">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock Text="Registrer film"
                       FontSize="30"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Titel"/>
            <TextBox Text="{Binding Movie.Title}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Varighed (minutter)"/>
            <TextBox Text="{Binding Movie.Duration}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Genre"/>
            <TextBox Text="{Binding Movie.Genre}"
                     Margin="0,0,0,20"/>

            <Button Content="Registrer film"
                    Height="30"/>

        </StackPanel>

    </Grid>
</Window>